<UserControl x:Class="SettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Padding="16">
  <StackPanel MaxWidth="480" HorizontalAlignment="Left">

    <!-- API Token -->
    <Label Content="Notion API Token" FontWeight="SemiBold" Margin="0,0,0,4"/>
    <Grid Margin="0,0,0,16">
      <PasswordBox x:Name="ApiTokenBox"
                   PasswordChanged="ApiTokenBox_PasswordChanged"
                   Padding="0,0,32,0"
                   ToolTip="Notion API token"/>
      <TextBox x:Name="VisibleApiTokenBox"
               TextChanged="VisibleApiTokenBox_TextChanged"
               Visibility="Collapsed"
               Padding="0,0,32,0"
               ToolTip="Notion API token"/>
      <TextBlock x:Name="ApiTokenPlaceholder"
                 Text="ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
                 Foreground="Gray"
                 IsHitTestVisible="False"
                 VerticalAlignment="Center"
                 Margin="7,0,36,0"/>
      <Button x:Name="ToggleApiTokenVisibilityButton"
              Content="👁"
              Click="ToggleApiTokenVisibilityButton_Click"
              ToolTip="Show token"
              HorizontalAlignment="Right"
              VerticalAlignment="Center"
              Width="28"
              Height="24"
              Margin="0,0,4,0"
              Padding="0"/>
    </Grid>

    <!-- Database ID -->
    <Label Content="Database ID" FontWeight="SemiBold" Margin="0,0,0,4"/>
    <Grid Margin="0,0,0,16">
      <TextBox x:Name="DatabaseIdBox"
               TextChanged="DatabaseIdBox_TextChanged"/>
      <TextBlock x:Name="DatabaseIdPlaceholder"
                 Text="0123456789abcdef0123456789abcdef"
                 Foreground="Gray"
                 IsHitTestVisible="False"
                 VerticalAlignment="Center"
                 Margin="7,0"/>
    </Grid>

    <!-- Title Property Name -->
    <Label Content="Title Property Name" FontWeight="SemiBold" Margin="0,0,0,4"/>
    <Grid>
      <TextBox x:Name="TitlePropertyNameBox"
               TextChanged="TitlePropertyNameBox_TextChanged"/>
      <TextBlock x:Name="TitlePropertyNamePlaceholder"
                 Text="Name"
                 Foreground="Gray"
                 IsHitTestVisible="False"
                 VerticalAlignment="Center"
                 Margin="7,0"/>
    </Grid>

  </StackPanel>
</UserControl>
